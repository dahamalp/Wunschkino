@page "/account/password"
@using Wunschkino.Auth
@inject UserService UserService
@inject NavigationManager Navigation

<PageTitle>@Texts.Password_PageTitle</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
    <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@Texts.Password_Title</MudText>
    <AccountNav Current="/account/password" />
    @if (_mustChange)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@Texts.Password_MustChange</MudAlert>
    }
    <MudPaper Class="pa-6" Elevation="1">
        <MudTextField @bind-Value="_current" Label="@Texts.Password_Current" InputType="@PasswordInputType" Variant="Variant.Outlined" Class="mb-3"
                      Adornment="Adornment.End" AdornmentIcon="@(_showPasswords ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="() => _showPasswords = !_showPasswords" AdornmentAriaLabel="@(_showPasswords ? Texts.Setup_HidePassword : Texts.Setup_ShowPassword)"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "current-password" })" />
        <MudTextField @bind-Value="_new" Label="@Texts.Password_New" InputType="@PasswordInputType" Variant="Variant.Outlined"
                      HelperText="@string.Format(Texts.Culture, Texts.Password_Min, UserValidation.MinPasswordLength)" Class="mb-3"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />
        <MudTextField @bind-Value="_repeat" Label="@Texts.Password_Repeat" InputType="@PasswordInputType" Variant="Variant.Outlined"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />

        <div aria-live="assertive">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
            }
        </div>

        <MudText Typo="Typo.body2" Class="mt-4">@Texts.Password_Notice</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SaveAsync" Disabled="_busy">@Texts.Password_Save</MudButton>
    </MudPaper>
</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string _current = "";
    private string _new = "";
    private string _repeat = "";
    private string? _error;
    private bool _busy;
    private bool _showPasswords;
    private bool _mustChange;

    protected override async Task OnInitializedAsync() => _mustChange = AuthClaims.MustChangePasswordNow((await AuthState).User);

    private InputType PasswordInputType => _showPasswords ? InputType.Text : InputType.Password;

    private async Task SaveAsync()
    {
        _error = null;
        if (_new != _repeat)
        {
            _error = Texts.Password_Mismatch;
            return;
        }

        _busy = true;
        try
        {
            var user = (await AuthState).User;
            if (AuthClaims.GetUserId(user) is not { } userId)
                return;

            var result = await UserService.ChangeOwnPasswordAsync(userId, _current, _new);
            if (!result.Success)
            {
                _error = result.Error;
                return;
            }
            Navigation.NavigateTo("/login?passwordChanged=true", forceLoad: true);
        }
        finally
        {
            _busy = false;
        }
    }
}
