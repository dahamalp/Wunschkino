<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Eine kleine App für wenige Nutzer: Der Server-GC würde ein Vielfaches an Speicher belegen. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <NeutralLanguage>de</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Data/ enthält neben dem Quelltext (Entities, Migrationen) auf Entwicklungsrechnern auch Laufzeitdaten
      (Zuordnungsliste, Schlüssel, Datenbank). Davon darf nie etwas in ein Release gelangen.
    -->
    <Content Remove="Data/**" />
    <None Remove="Data/**" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Auth\common-passwords.txt.gz" LogicalName="Wunschkino.Auth.common-passwords.txt.gz" />
    <!-- Alle Oberflächentexte: Texts.resx ist Deutsch (Standard), weitere Sprachen kommen als Texts.<Kultur>.resx hinzu. -->
    <EmbeddedResource Update="Resources\Texts.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Texts.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Wunschkino.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Texts</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
